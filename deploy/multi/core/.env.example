# Outline Optimized – core node configuration
# Copy to .env and fill in. CORE_BIND_IP is this host's address on the private
# network (WireGuard / Tailscale / VLAN) – the only interface Postgres and
# Redis are published on, so they stay unreachable from the public internet.

# e.g. 100.64.0.1 (Tailscale) or 10.0.0.1 (WireGuard)
CORE_BIND_IP=

POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=outline

# Memory caps (see docs/DEPLOYMENT.md for sizing guidance)
POSTGRES_MEM_LIMIT=1g
REDIS_MEM_LIMIT=768m

# Postgres tuning
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAX_CONNECTIONS=200

# Redis data-size cap before cached keys start being evicted (queue keys are
# never evicted). Keep a bit below REDIS_MEM_LIMIT.
REDIS_MAXMEMORY=512mb

# The app and worker nodes need these same two values:
#   POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB (in their DATABASE_URL)
