# Outline Optimized – app node configuration
# Copy to .env and fill in. This node serves users; point it at the core
# node's private (VPN) address for Postgres and Redis.

# The public URL of the site, e.g. https://docs.example.com
URL=

# Must match the values used by every other Outline node.
SECRET_KEY=
UTILS_SECRET=

# Web/collaboration process count. Rule of thumb: 1 per ~512MB of
# OUTLINE_MEM_LIMIT. Requires REDIS_COLLABORATION_URL below when > 1.
WEB_CONCURRENCY=2

FORCE_HTTPS=true

# ––––––––––––––––––––––––––––––––––––––
# ––––––––  CORE NODE CONNECTION  –––––
# ––––––––––––––––––––––––––––––––––––––
# Replace CORE_HOST and DB_PASSWORD below with the core node's private VPN
# address and the Postgres password you set on it.

DATABASE_URL=postgres://user:DB_PASSWORD@CORE_HOST:5432/outline
REDIS_URL=redis://CORE_HOST:6379

# Required so collaboration/websockets sync across processes and replicas.
REDIS_COLLABORATION_URL=redis://CORE_HOST:6379

# Connections ride the encrypted private network and the bundled core
# Postgres doesn't terminate TLS. Remove this only if you enabled SSL there.
PGSSLMODE=disable

# ––––––––––––––––––––––––––––––––––––––
# –––––––––––  FILE STORAGE  –––––––––––
# ––––––––––––––––––––––––––––––––––––––
# S3-compatible storage is REQUIRED with more than one node (attachments must
# be shared). Cloudflare R2 works well and pairs with the tunnel.

FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_UPLOAD_BUCKET_URL=
AWS_S3_UPLOAD_BUCKET_NAME=
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private

# ––––––––––––––––––––––––––––––––––––––
# –––––––  AUTHENTICATION (one needed)  –
# ––––––––––––––––––––––––––––––––––––––

OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_SERVICE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ––––––––––––––––––––––––––––––––––––––
# –––––––  MEMORY LIMITS (caps)  –––––––
# ––––––––––––––––––––––––––––––––––––––

OUTLINE_MEM_LIMIT=2g
TUNNEL_MEM_LIMIT=128m
REDIS_MAXMEMORY=512mb

# Optional explicit per-process heap override in MB:
# NODE_OPTIONS=--max-old-space-size=768

# ––––––––––––––––––––––––––––––––––––––
# –––––––  CLOUDFLARE TUNNEL  ––––––––––
# ––––––––––––––––––––––––––––––––––––––
# Map your public hostname to http://outline:3000 for this node's tunnel.

CF_TUNNEL_TOKEN=

OUTLINE_IMAGE=outline-optimized:local
OUTLINE_BIND_IP=127.0.0.1
OUTLINE_PORT=3000
