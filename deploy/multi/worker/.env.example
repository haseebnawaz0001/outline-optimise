# Outline Optimized – worker node configuration
# Copy to .env and fill in. SECRET_KEY / UTILS_SECRET / URL / storage must
# match the app nodes exactly.

# Same public URL as the app nodes, e.g. https://docs.example.com
URL=

# Must match the other nodes.
SECRET_KEY=
UTILS_SECRET=

# Replace CORE_HOST and DB_PASSWORD with the core node's private VPN address
# and Postgres password.
DATABASE_URL=postgres://user:DB_PASSWORD@CORE_HOST:5432/outline
REDIS_URL=redis://CORE_HOST:6379
REDIS_COLLABORATION_URL=redis://CORE_HOST:6379

# Connections ride the encrypted private network and the bundled core
# Postgres doesn't terminate TLS. Remove this only if you enabled SSL there.
PGSSLMODE=disable

# S3-compatible storage is REQUIRED in a multi-node deployment.
FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_UPLOAD_BUCKET_URL=
AWS_S3_UPLOAD_BUCKET_NAME=
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_ACL=private

# Memory cap for the worker container (single process; Node derives ~80% of
# this as its V8 heap limit automatically).
WORKER_MEM_LIMIT=1g

OUTLINE_IMAGE=outline-optimized:local
