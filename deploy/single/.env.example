# Outline Optimized – single VPS configuration
# Copy to .env and fill in the required values. This file intentionally only
# lists what matters for deployment; see ../../.env.sample for every
# application option (auth providers, SMTP, S3, rate limits, etc).

# ––––––––––––––––––––––––––––––––––––––
# ––––––––––––––  CORE  –––––––––––––––
# ––––––––––––––––––––––––––––––––––––––

# The public URL users visit. With a Cloudflare Tunnel this is your tunneled
# https domain; without one it is http://<vps-ip>:3000 (or your own proxy).
URL=

# Generate with: openssl rand -hex 32
SECRET_KEY=
UTILS_SECRET=

# Number of web/collaboration processes. Rule of thumb: 1 process per ~512MB
# of OUTLINE_MEM_LIMIT. Keep at 1 unless you raised the memory limit.
WEB_CONCURRENCY=1

FORCE_HTTPS=true

# ––––––––––––––––––––––––––––––––––––––
# –––––––––––––  DATABASE  –––––––––––––
# ––––––––––––––––––––––––––––––––––––––

POSTGRES_USER=user
POSTGRES_PASSWORD=
POSTGRES_DB=outline

# Lets web/collaboration processes sync state through Redis, required when
# WEB_CONCURRENCY > 1.
REDIS_COLLABORATION_URL=redis://redis:6379

# ––––––––––––––––––––––––––––––––––––––
# ––––––––––  AUTHENTICATION  ––––––––––
# ––––––––––––––––––––––––––––––––––––––
# At least one provider must be configured to be able to sign in.

# Generic OIDC (works with Authentik, Keycloak, Auth0, WorkOS, etc.)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUTH_URI=
OIDC_TOKEN_URI=
OIDC_USERINFO_URI=
OIDC_DISPLAY_NAME=OpenID Connect
OIDC_SCOPES=openid profile email

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in requires SMTP below.
SMTP_SERVICE=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ––––––––––––––––––––––––––––––––––––––
# –––––––  MEMORY LIMITS (caps)  –––––––
# ––––––––––––––––––––––––––––––––––––––
# Hard container caps. The Node process derives its V8 heap limit from the
# Outline container cap automatically (~80% split across WEB_CONCURRENCY
# processes, 256MB floor each), so these are the only knobs you need.

# Total for all Outline Node processes (web, collaboration, worker, cron).
OUTLINE_MEM_LIMIT=1g
POSTGRES_MEM_LIMIT=512m
REDIS_MEM_LIMIT=384m
TUNNEL_MEM_LIMIT=128m

# Redis data-size cap before cached keys start being evicted (queue keys are
# never evicted). Keep a bit below REDIS_MEM_LIMIT.
REDIS_MAXMEMORY=256mb

# Optional explicit override of the per-process heap in MB, e.g.:
# NODE_OPTIONS=--max-old-space-size=768

# ––––––––––––––––––––––––––––––––––––––
# –––––––  CLOUDFLARE TUNNEL  ––––––––––
# ––––––––––––––––––––––––––––––––––––––
# Create a "Cloudflared" tunnel in the Cloudflare Zero Trust dashboard, map
# your hostname to http://outline:3000, then paste the token here and run:
#   docker compose --profile tunnel up -d

CF_TUNNEL_TOKEN=

# ––––––––––––––––––––––––––––––––––––––
# ––––––––––––––  IMAGE  –––––––––––––––
# ––––––––––––––––––––––––––––––––––––––
# Default matches ../build.sh. Point this at your own registry tag if you
# build once and pull on the server, e.g. ghcr.io/you/outline-optimise:latest
OUTLINE_IMAGE=outline-optimized:local

# Host port binding. Loopback by default so only the tunnel exposes Outline.
OUTLINE_BIND_IP=127.0.0.1
OUTLINE_PORT=3000
